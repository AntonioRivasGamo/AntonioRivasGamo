<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 330" width="820" height="330" role="img" aria-label="Animated bash terminal">
  <style>
    text { font-family: 'JetBrains Mono', 'Fira Code', Consolas, 'Courier New', monospace; font-size: 15px; }
    .user { fill: #9ece6a; }
    .path { fill: #7aa2f7; }
    .txt  { fill: #c0caf5; }
    .cmd  { fill: #c0caf5; }
    .out  { fill: #7dcfff; opacity: 0; animation: show 0.4s ease-out forwards; }
    .ok   { fill: #9ece6a; }
    .pur  { fill: #bb9af7; }
    .p    { opacity: 0; animation: show 0.01s linear forwards; }
    .wipe { transform-box: fill-box; transform-origin: left center; transform: scaleX(0); animation-name: type; animation-timing-function: steps(var(--n), end); animation-fill-mode: forwards; }
    .cursor { fill: #c0caf5; opacity: 0; animation: blink 1s steps(1) infinite; animation-delay: 9s; }
    @keyframes show { to { opacity: 1; } }
    @keyframes type { to { transform: scaleX(1); } }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  </style>

  <defs>
    <clipPath id="c1"><rect class="wipe" x="188" y="74" width="200" height="22" style="--n:6;animation-duration:0.8s;animation-delay:0.6s"/></clipPath>
    <clipPath id="c2"><rect class="wipe" x="188" y="134" width="200" height="22" style="--n:13;animation-duration:1.2s;animation-delay:2.6s"/></clipPath>
    <clipPath id="c3"><rect class="wipe" x="188" y="194" width="200" height="22" style="--n:13;animation-duration:1.2s;animation-delay:5s"/></clipPath>
    <clipPath id="c4"><rect class="wipe" x="188" y="254" width="200" height="22" style="--n:12;animation-duration:1.1s;animation-delay:7.4s"/></clipPath>
  </defs>

  <!-- Window -->
  <rect x="1" y="1" width="818" height="328" rx="12" fill="#1a1b26" stroke="#7aa2f7" stroke-opacity="0.35" stroke-width="2"/>
  <path d="M1 13 a12 12 0 0 1 12 -12 h794 a12 12 0 0 1 12 12 v27 h-818 z" fill="#16161e"/>
  <circle cx="26" cy="21" r="7" fill="#f7768e"/>
  <circle cx="50" cy="21" r="7" fill="#e0af68"/>
  <circle cx="74" cy="21" r="7" fill="#9ece6a"/>
  <text x="410" y="26" text-anchor="middle" fill="#565f89" font-size="13">antonio@madrid: ~</text>

  <!-- Line 1 -->
  <g class="p" style="animation-delay:0.6s">
    <text x="24" y="90"><tspan class="user">antonio@madrid</tspan><tspan class="txt">:</tspan><tspan class="path">~</tspan><tspan class="txt">$ </tspan></text>
  </g>
  <text x="188" y="90" class="cmd" clip-path="url(#c1)">whoami</text>
  <text x="24" y="114" class="out" style="animation-delay:1.6s">Antonio Rivas · Full Stack Developer · Madrid, ES</text>

  <!-- Line 2 -->
  <g class="p" style="animation-delay:2.6s">
    <text x="24" y="150"><tspan class="user">antonio@madrid</tspan><tspan class="txt">:</tspan><tspan class="path">~</tspan><tspan class="txt">$ </tspan></text>
  </g>
  <text x="188" y="150" class="cmd" clip-path="url(#c2)">cat stack.txt</text>
  <text x="24" y="174" class="out" style="animation-delay:4s">Java · Spring Boot · Docker · Kubernetes · Python · FastAPI</text>

  <!-- Line 3 -->
  <g class="p" style="animation-delay:5s">
    <text x="24" y="210"><tspan class="user">antonio@madrid</tspan><tspan class="txt">:</tspan><tspan class="path">~</tspan><tspan class="txt">$ </tspan></text>
  </g>
  <text x="188" y="210" class="cmd" clip-path="url(#c3)">ls ~/projects</text>
  <text x="24" y="234" class="out" style="animation-delay:6.4s"><tspan class="pur">PygmyGoat/</tspan><tspan class="out">  </tspan><tspan class="ok">[ in progress ]</tspan></text>

  <!-- Line 4 -->
  <g class="p" style="animation-delay:7.4s">
    <text x="24" y="270"><tspan class="user">antonio@madrid</tspan><tspan class="txt">:</tspan><tspan class="path">~</tspan><tspan class="txt">$ </tspan></text>
  </g>
  <text x="188" y="270" class="cmd" clip-path="url(#c4)">echo $STATUS</text>
  <text x="24" y="294" class="out" style="animation-delay:8.6s"><tspan class="ok">✔</tspan><tspan class="out"> building cool things, open to collaborate</tspan></text>
  <rect class="cursor" x="24" y="302" width="9" height="3"/>
</svg>
